#!/usr/bin/env node

/**
 * git-credential-nostr
 *
 * A git credential helper that generates NIP-98 tokens for authentication.
 * Enables `git push` to Solid servers using Nostr identity.
 *
 * Usage:
 *   git config --global credential.helper nostr
 *   git config --global nostr.privkey <64-char-hex>
 *
 * See: https://github.com/JavaScriptSolidServer/git-credential-nostr
 */

import { execSync } from 'child_process'
import { generateSecretKey, getPublicKey, finalizeEvent } from 'nostr-tools/pure'
import { hexToBytes, bytesToHex } from '@noble/hashes/utils'
import fs from 'fs'
import readline from 'readline'

const command = process.argv[2]

// ============================================================================
// Command: generate - Create a new keypair
// ============================================================================
if (command === 'generate') {
  const sk = generateSecretKey()
  const pk = getPublicKey(sk)
  const privkeyHex = bytesToHex(sk)

  console.log('Generated new Nostr keypair:\n')
  console.log(`  Private key: ${privkeyHex}`)
  console.log(`  Public key:  ${pk}`)
  console.log(`  WebID:       did:nostr:${pk}`)
  console.log('\nSetup:\n')
  console.log(`  git config --global nostr.privkey ${privkeyHex}`)
  console.log('\nAdd this to your ACL for write access:\n')
  console.log(`  acl:agent <did:nostr:${pk}>`)

  process.exit(0)
}

// ============================================================================
// Command: get - Called by git to get credentials
// ============================================================================
if (command === 'get') {
  // Read git credential protocol input
  const rl = readline.createInterface({ input: process.stdin })
  const params = {}

  for await (const line of rl) {
    if (!line) break
    const [key, ...vals] = line.split('=')
    params[key] = vals.join('=')
  }

  // Get private key from git config
  let privkeyHex

  // Try nostr.privkey first
  try {
    privkeyHex = execSync('git config nostr.privkey', {
      encoding: 'utf8',
      stdio: ['pipe', 'pipe', 'pipe']
    }).trim()
  } catch {
    // Try nostr.keyfile
    try {
      const keyfile = execSync('git config nostr.keyfile', {
        encoding: 'utf8',
        stdio: ['pipe', 'pipe', 'pipe']
      }).trim()
      privkeyHex = fs.readFileSync(keyfile, 'utf8').trim()
    } catch {
      // No nostr key configured, exit silently to let git try other helpers
      process.exit(0)
    }
  }

  if (!privkeyHex || privkeyHex.length !== 64) {
    // Invalid key, exit silently
    process.exit(0)
  }

  // Check if this host should use nostr auth (optional restriction)
  try {
    const hostsConfig = execSync('git config nostr.hosts', {
      encoding: 'utf8',
      stdio: ['pipe', 'pipe', 'pipe']
    }).trim()
    const hosts = hostsConfig.split(/\s+/)
    const requestHost = params.host?.split(':')[0]
    if (!hosts.includes(requestHost)) {
      // Not a nostr-enabled host, skip
      process.exit(0)
    }
  } catch {
    // No host restriction, use for all hosts
  }

  // Build base URL (remove git-specific path suffixes)
  let path = params.path || '/'
  path = path.replace(/\/info\/refs$/, '').replace(/\/git-.*$/, '')
  const baseUrl = `${params.protocol}://${params.host}${path}`

  // Generate NIP-98 token
  const sk = hexToBytes(privkeyHex)
  const event = finalizeEvent({
    kind: 27235,
    created_at: Math.floor(Date.now() / 1000),
    tags: [
      ['u', baseUrl],
      ['method', '*']
    ],
    content: ''
  }, sk)

  const token = Buffer.from(JSON.stringify(event)).toString('base64')

  // Output credentials in git credential protocol format
  console.log('username=nostr')
  console.log(`password=${token}`)

  process.exit(0)
}

// ============================================================================
// Command: store / erase - Ignored (we don't persist anything)
// ============================================================================
if (command === 'store' || command === 'erase') {
  // Nothing to do - we generate tokens on the fly
  process.exit(0)
}

// ============================================================================
// No command or help
// ============================================================================
console.log(`git-credential-nostr - Nostr (NIP-98) authentication for git

Commands:
  generate          Generate a new Nostr keypair
  get               Get credentials (called by git)
  store             Store credentials (ignored)
  erase             Erase credentials (ignored)

Setup:
  git config --global credential.helper nostr
  git config --global nostr.privkey <64-char-hex-private-key>

Options:
  nostr.privkey     Your Nostr private key (64 hex chars)
  nostr.keyfile     Path to file containing private key
  nostr.hosts       Space-separated list of hosts to use nostr auth for

Example:
  git-credential-nostr generate
  git config --global credential.helper nostr
  git config --global nostr.privkey <key-from-generate>
  git push  # Now uses NIP-98 authentication
`)
